+    #[cold]
+    #[inline(never)]
+    fn clore_v1(&mut self) -> core::result::Result<usize, u64> {
+        let s = &self.flux;
+        let rx_used = self.cadres[2].mem;
+        let tx_used = self.cadres[5].mem;
+        if s.en_vol != 0
+            || s.preparees != s.completees
+            || s.publiees != s.completees
