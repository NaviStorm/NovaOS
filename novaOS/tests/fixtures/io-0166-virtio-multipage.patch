+/// Le pilote ne donne que des LBA relatifs à la partition et le rang déjà réservé.
+pub(crate) fn multipage(
+    pid: u64,
+    key: u64,
+    mut demande: crate::sched::process::ipc::DemandeDma,
+) -> core::result::Result<u64, u64> {
+    let mut s = SESSION.lock();
+    if !admit(pid, key) || s.quarantine {
+        return Err(abi::REVOKED);
+    }
+    if s.rights & (if demande.ecrire { 2 } else { 1 }) == 0 {
+        return Err(abi::DENIED);
+    }
+    if s.phase != Phase::Empty {
+        return Err(abi::REFUSED);
+    }
+    let d = s.device.as_deref_mut().ok_or(abi::CLOSED)?;
+    let pas = (PAGE / d.size) as u64;
+    demande.nombre = demande.nombre.min(d.arena.limite);
+    demande.verifier(pas, false)?;
+    let secteurs = (demande.nombre as u64)
+        .checked_mul(pas)
+        .ok_or(abi::BAD_ARGUMENT)?;
+    if demande
+        .premier
+        .checked_add(secteurs)
+        .is_none_or(|fin| fin > d.count)
+    {
+        return Err(abi::BAD_ARGUMENT);
+    }
+    let depart = d
+        .first
+        .checked_add(demande.premier)
+        .ok_or(abi::BAD_ARGUMENT)?;
+    if d.chaine_dma(demande, depart, pas, || admit(pid, key))
+        .is_err()
+    {
+        s.phase = Phase::Closed;
+        return Err(abi::REFUSED);
+    }
+    Ok(demande.nombre as u64)
+}
