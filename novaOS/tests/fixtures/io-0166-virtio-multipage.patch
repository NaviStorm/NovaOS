+//! Arène superviseur du prototype. Une seule chaîne en vol sur le BSP.
+use super::*;
+use crate::sched::process::ipc::DemandeDma;
+use alloc::vec::Vec;
+
+pub(super) const MAX: usize = 64;
+const BASE: usize = 8; // n=7 reste non traduit.
+fn slot(ecrire: bool, i: usize) -> usize {
+    BASE + usize::from(ecrire) * MAX + i
+}
+pub(super) fn traduction(n: usize, pa: u64, droits: u32) -> bool {
+    if pa % PAGE as u64 != 0 || (pa == 0) != (droits == 0) {
+        return false;
+    }
+    if n < 7 {
+        return droits <= 3;
+    }
+    (BASE..BASE + 2 * MAX).contains(&n)
+        && (droits == 0 || droits == if n < BASE + MAX { 2 } else { 1 })
+}
+pub(super) struct Arena {
+    pub limite: usize,
+    cadres: [Vec<Frame>; 2],
+    retraits: [usize; 2],
+}
+impl Arena {
+    pub fn new(limite: usize) -> Self {
+        Self {
+            limite,
+            cadres: [Vec::new(), Vec::new()],
+            retraits: [0; 2],
+        }
+    }
+    fn assurer(
+        &mut self,
+        unite: &mut domain::Domain,
+        p: &Pages,
+        ecrire: bool,
+        n: usize,
+    ) -> Result<()> {
+        if n == 0 || n > self.limite || n > MAX {
+            return Err(Error::Geometry);
+        }
+        let cadres = &mut self.cadres[usize::from(ecrire)];
+        cadres
+            .try_reserve_exact(n.saturating_sub(cadres.len()))
+            .map_err(|_| Error::Memory)?;
+        while cadres.len() < n {
+            let i = cadres.len();
+            let f = Frame::allocate()?;
+            // Initialiser aussi les pages que le périphérique pourra lire avant le premier OUT.
+            // Sûreté : le cadre vient d'être alloué et n'a pas encore de traduction IOMMU.
+            unsafe {
+                (f.mem.base() as *mut u8).write_bytes(0, PAGE);
+            }
+            cadres.push(f); // Conserver le cadre même si l'acquittement MAP est incertain.
+            unite.map(p, slot(ecrire, i), f.pa, if ecrire { 1 } else { 2 })?;
+        }
+        Ok(())
+    }
+    pub fn retirer(&mut self, unite: &mut domain::Domain, p: &Pages) -> Result<()> {
+        for (sens, cadres) in self.cadres.iter().enumerate() {
+            while self.retraits[sens] < cadres.len() {
+                unite.retirer_slot(p, slot(sens == 1, self.retraits[sens]))?;
+                self.retraits[sens] += 1;
+            }
+        }
+        Ok(())
+    }
+    /// # Safety
+    /// Le reset, le retrait de toutes les traductions et le détachement ont été acquittés.
+    pub unsafe fn liberer(self) {
+        for f in self.cadres.into_iter().flatten() {
+            // Sûreté : quiescence et arrêt du domaine garantis par l'appelant.
+            unsafe {
+                crate::memory::release_dma(f.pa);
+            }
+        }
+    }
+    fn copier(&self, d: DemandeDma) -> core::result::Result<(), u64> {
+        let t = trace_dma::temps();
+        let pages = &self.cadres[usize::from(d.ecrire)];
+        let r = d.copier(|i| pages[i].mem.base());
+        trace_dma::copie(t, d.ecrire);
+        r
+    }
+}
+impl Transport {
+    pub(super) fn chaine_dma(
+        &mut self,
+        d: DemandeDma,
+        depart: u64,
+        pas: u64,
+        bail_actif: impl Fn() -> bool,
+    ) -> Result<()> {
+        let bytes = d.nombre.checked_mul(PAGE).ok_or(Error::Geometry)?;
+        if self.pending.is_some()
+            || bytes == 0
+            || d.nombre > self.arena.limite
+            || d.nombre > MAX
+            || d.nombre + 2 > usize::from(self.q.entries)
+            || (d.ecrire && (self.ro || !self.output_mapped))
+            || depart
+                .checked_add((bytes / self.size) as u64)
+                .is_none_or(|fin| fin > self.sectors)
+        {
+            return Err(Error::State);
+        }
+        let sector = depart
+            .checked_mul((self.size / 512) as u64)
+            .ok_or(Error::Geometry)?;
+        self.unit.faults(&self.p)?;
+        self.arena
+            .assurer(&mut self.unit, &self.p, d.ecrire, d.nombre)?;
+        if d.ecrire {
+            self.arena.copier(d).map_err(|_| Error::State)?;
+        }
+        let h = self.p.0[19].mem;
+        h.w32(0, u32::from(d.ecrire));
+        h.w32(4, 0);
+        h.w64(8, sector);
+        self.p.0[21].mem.w8(0, 0xff);
+        let mut parts = [Segment::new(0, 0, false); MAX + 2];
+        parts[0] = Segment::new(addr(3), 16, false);
+        for (i, part) in parts[1..1 + d.nombre].iter_mut().enumerate() {
+            *part = Segment::new(addr(slot(d.ecrire, i)), PAGE as u32, !d.ecrire);
+        }
+        parts[1 + d.nombre] = Segment::new(addr(5), 1, true);
+        self.kind = usize::from(d.ecrire);
+        self.started = metrics::stamp();
+        let irq = hal::interrupts::Guard::new();
+        if !bail_actif() {
+            return Err(Error::State);
+        }
+        d.verifier(pas, true).map_err(|_| Error::State)?;
+        let seen = IRQS.load(Ordering::Acquire);
+        EXPECT.store(
+            0x10000 | u64::from(self.q.index.wrapping_add(1)),
+            Ordering::Release,
+        );
+        if let Err(erreur) = self.q.submit(&parts[..d.nombre + 2]) {
+            let _ = d.terminer(false, false);
+            return Err(erreur);
+        }
+        self.dernier_kick = trace_dma::soumis(self.started);
+        KICKS.fetch_add(1, Ordering::Release);
+        self.pending = Some(seen);
+        drop(irq);
+        let complet = self.finish(if d.ecrire { 1 } else { 1 + bytes as u32 });
+        if complet.is_err() {
+            let _ = d.terminer(false, false); // doute : le retrait ne déclare jamais le DMA terminé.
+            return complet;
+        }
+        // Vérifier de nouveau le bail et rendre la réponse sous le même masque BSP.
+        // Les contrôles des deux extrémités IPC se font dans copier et terminer.
+        let garde = hal::interrupts::Guard::new();
+        let copie = if !bail_actif() {
+            Err(crate::abi::REVOKED)
+        } else if d.ecrire {
+            Ok(())
+        } else {
+            self.arena.copier(d)
+        };
+        let fin = d.terminer(true, copie.is_ok());
+        drop(garde);
+        trace_dma::groupe(
+            d.ecrire,
+            d.nombre,
+            self.arena.cadres[0].len() + self.arena.cadres[1].len(),
+        );
+        copie.and(fin).map_err(|_| Error::State)
+    }
+}
