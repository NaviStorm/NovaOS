+//! La liste de LBA figée par le moteur est la seule autorité du lot.
+use super::*;
+
+#[derive(Clone, Copy)]
+pub(crate) struct DemandeDma {
+    tag: u64,
+    cap: u64,
+    pub premier: u64,
+    index: usize,
+    total: usize,
+    pub nombre: usize,
+    pub ecrire: bool,
+}
+impl DemandeDma {
+    pub(crate) fn nouvelle(
+        tag: u64,
+        cap: u64,
+        premier: u64,
+        index: u64,
+        total: u64,
+        nombre: u64,
+        direction: u64,
+    ) -> Res<Self> {
+        if tag == 0
+            || !(1..=256).contains(&total)
+            || index >= total
+            || nombre == 0
+            || nombre > total - index
+            || direction > 1
+        {
+            return Err(BAD_ARGUMENT);
+        }
+        Ok(Self {
+            tag,
+            cap,
+            premier,
+            index: index as usize,
+            total: total as usize,
+            nombre: nombre as usize,
+            ecrire: direction == 1,
+        })
+    }
+    fn bail(self, s: &Core) -> Res<(Reference, Lane, Reservation)> {
+        let pid = s.thread(s.current).owner.ok_or(DENIED)?;
+        let node = s.ipc.lookup(pid, self.cap, SEND | RECEIVE)?;
+        let lane = s.ipc.ends.get(node.endpoint.slot()).bulk.ok_or(REVOKED)?;
+        let r = lane.reservation.ok_or(REVOKED)?;
+        if lane.nodes[0] != node.id
+            || lane.parties[0] != pid.number
+            || lane.handles[0] != self.cap
+            || lane.parties[1] != r.moteur.number
+        {
+            return Err(DENIED);
+        }
+        let moteur = s.processes.slots[r.moteur.slot]
+            .as_ref()
+            .filter(|p| p.pid == r.moteur && p.space.is_some())
+            .ok_or(REVOKED)?;
+        let pair = s.ipc.lookup(moteur.pid, lane.handles[1], SEND | RECEIVE)?;
+        if pair.id != lane.nodes[1]
+            || pair.endpoint != node.endpoint
+            || r.tag != self.tag
+            || r.n != self.total
+            || r.index != self.index
+            || r.effectues != self.index
+            || r.lire == self.ecrire
+            || r.flush
+            || r.doute
+        {
+            return Err(REFUSED);
+        }
+        Ok((node.endpoint, lane, r))
+    }
+    // Les deux vérifications encadrent la préparation DMA. La dernière s'exécute
+    // sans interruption jusqu'à la publication de avail.idx et au doorbell.
+    pub(crate) fn verifier(self, pas: u64, soumettre: bool) -> Res<()> {
+        with(|s| {
+            let (ep, lane, r) = self.bail(s)?;
+            if r.retrait || r.en_vol {
+                return Err(REVOKED);
+            }
+            let offsets = s.ipc.pages_bulk.get(lane.slot);
+            for j in 0..self.nombre {
+                let debut = (self.index + j) * 8;
+                let attendu = u64::from_le_bytes(offsets[debut..debut + 8].try_into().unwrap());
+                if self.premier.checked_add(j as u64 * pas) != Some(attendu) {
+                    return Err(REFUSED);
+                }
+            }
+            if soumettre {
+                s.ipc
+                    .ends
+                    .get_mut(ep.slot())
+                    .bulk
+                    .as_mut()
+                    .unwrap()
+                    .reservation
+                    .as_mut()
+                    .unwrap()
+                    .en_vol = true;
+            }
+            Ok(())
+        })
+    }
+    pub(crate) fn copier(self, page: impl Fn(usize) -> usize) -> Res<()> {
+        with(|s| {
+            let (_, _, r) = self.bail(s)?;
+            if r.retrait || r.en_vol == self.ecrire {
+                return Err(REVOKED);
+            }
+            let espace = s.processes.get(r.moteur).space.as_ref().ok_or(REVOKED)?;
+            let base = r.base + 4096 * self.index as u64;
+            heap::with_pages(|m| {
+                // Aucune copie partielle vers le moteur si une traduction manque.
+                if !(0..self.nombre).all(|i| espace.writable(m, base + 4096 * i as u64, 4096)) {
+                    return Ok(Err(BAD_ADDRESS));
+                }
+                for i in 0..self.nombre {
+                    // Sûreté : le transport fournit l'alias superviseur d'un cadre épinglé privé.
+                    // OUT précède le kick ; IN suit used, l'IRQ, la longueur et le statut.
+                    unsafe {
+                        espace.copier_dma(
+                            m,
+                            base + 4096 * i as u64,
+                            page(i) as *mut u8,
+                            self.ecrire,
+                        );
+                    }
+                }
+                Ok(Ok(()))
+            })
+            .unwrap()
+        })
+    }
+    pub(crate) fn terminer(self, complet: bool, livre: bool) -> Res<()> {
+        with(|s| {
+            let (ep, _, r) = self.bail(s)?;
+            if !r.en_vol {
+                return Err(REFUSED);
+            }
+            let r = s
+                .ipc
+                .ends
+                .get_mut(ep.slot())
