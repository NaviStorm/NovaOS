+impl UserSpace {
+    /// # Safety
+    /// dma désigne un cadre privé de 4096 octets, distinct des pages utilisateur.
+    /// L'appelant tient Memory et possède l'usage CPU exclusif du cadre pour cette copie.
+    pub(crate) unsafe fn copier_dma(&self, m: &Memory, va: u64, dma: *mut u8, vers_dma: bool) {
+        let parties = self
+            .segments(m, va, 4096, !vers_dma)
+            .expect("plage DMA prévalidée sous Memory");
+        let mut debut = 0;
+        for (usager, n) in parties {
+            if n == 0 {
+                continue;
+            }
+            // Sûreté : les deux plages disjointes sont validées et épinglées.
+            unsafe {
+                if vers_dma {
+                    core::ptr::copy_nonoverlapping(usager, dma.add(debut), n);
+                } else {
+                    core::ptr::copy_nonoverlapping(dma.add(debut), usager, n);
+                }
+            }
+            debut += n;
+        }
+    }
+}
