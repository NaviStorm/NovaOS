+/// Qualification privée : remonter le même disque et détruire la chaîne à chaque tour.
+pub(crate) fn endurance_cli() -> bool {
+    let mut reference = None;
+    for tour in 1..=64 {
+        if !volume(42) {
+            return false;
+        }
+        let repos = heap::audit(true);
+        let ipc = with(|s| (s.processes.slots.iter().flatten().count(), s.ipc.pages()));
+        let attendu = *reference.get_or_insert(repos);
+        hal::log(format_args!(
+            "ENDURANCE tour={tour} libres={} blocs={} occupes={} engages={} processus={} pages_ipc={}",
+            repos.free_pages, repos.blocks, repos.occupied, repos.committed, ipc.0, ipc.1
+        ));
+        if repos != attendu || ipc != (0, 0) {
+            return false;
+        }
+    }
+    true
+}
