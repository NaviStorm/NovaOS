+//! Compteurs BSP uniquement dans l'invité de métrologie.
+use crate::{hal, mesures_save as mesure};
+use core::sync::atomic::{AtomicU64, Ordering::Relaxed};
+static KICK: AtomicU64 = AtomicU64::new(0);
+pub(super) fn temps() -> u64 {
+    if mesure::dma_active() {
+        hal::timer::counter()
+    } else {
+        0
+    }
+}
+pub(super) fn soumis(debut: u64) -> u64 {
+    let fin = temps();
+    if fin != 0 {
+        mesure::dma_ajouter(8, 1);
+        mesure::dma_ajouter(9, fin.saturating_sub(debut));
+        KICK.store(fin, Relaxed);
+    }
+    fin
+}
+pub(super) fn acquitte(kick: u64, used: u64) {
+    if kick != 0 {
+        mesure::dma_ajouter(10, used.saturating_sub(kick));
+        mesure::dma_ajouter(11, temps().saturating_sub(used));
+    }
+}
+pub(super) fn irq(entree: u64) {
+    if entree != 0 {
+        mesure::dma_ajouter(12, 1);
+        mesure::dma_ajouter(13, temps().saturating_sub(entree));
+        mesure::dma_ajouter(14, entree.saturating_sub(KICK.load(Relaxed)));
+    }
+}
+pub(super) fn copie(entree: u64, ecrire: bool) {
+    if entree != 0 {
+        mesure::dma_ajouter(6 + usize::from(ecrire), temps() - entree);
+        mesure::dma_ajouter(usize::from(ecrire),1);
+    }
+}
