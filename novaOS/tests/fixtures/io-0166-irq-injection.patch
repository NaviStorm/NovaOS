+// Injection du laboratoire sur la seule ligne du disque jetable.
+pub(crate) fn injecter_spi_disque() {
+    write(DIST, 0x204, 1 << (disk_id() - 32));
+    unsafe { asm!("dsb sy", "isb", options(nostack, preserves_flags)); }
+}
+pub(crate) fn ligne_disque_active() -> bool {
+    read(DIST, 0x104) & (1 << (disk_id() - 32)) != 0
+}
