+    fn projeter_invite(&mut self, e: &Editor) -> (usize, usize) {
+        self.label.clear();
+        self.label
+            .push(if e.mode == Mode::Search { '/' } else { ':' });
+        self.label.push_str(&e.prompt);
+        let fin = self.label.chars().map(width).sum::<usize>();
+        let gauche = fin.saturating_sub(self.cols - 1);
+        project(&mut self.line, self.label.chars(), gauche, self.cols);
+        (self.rows - 1, fin - gauche)
+    }
