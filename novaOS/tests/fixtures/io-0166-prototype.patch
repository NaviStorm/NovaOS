+#[inline(never)]
+fn commande_lot(ptr: u64) -> Result<u64, u64> {
+    use crate::hardware::block;
+    let pid = with(|s| caller(s));
+    let mut q = [0u8; 56];
+    let lire = |addr: u64, out: &mut [u8]| {
+        with(|s| {
+            heap::with_pages(|m| {
+                Ok(s.processes
+                    .get(pid)
+                    .space
+                    .as_ref()
+                    .unwrap()
+                    .copy_from_user(m, addr, out))
+            })
+            .unwrap()
+        })
+    };
+    if ptr % 8 != 0 || !lire(ptr, &mut q) {
+        return Err(BAD_ADDRESS);
+    }
+    let mot = |i: usize| u64::from_le_bytes(q[i * 8..i * 8 + 8].try_into().unwrap());
+    let (tag, cap, key, d, adresse, i, n) =
+        (mot(0), mot(1), mot(2), mot(3), mot(4), mot(5), mot(6));
+    if !block::admit(pid.number, key) {
+        return Err(DENIED);
+    }
+    let mut w = [0; 128];
+    let mut page = [0; 4096];
+    if d % 8 != 0 || !lire(d, &mut w) {
+        return Err(BAD_ADDRESS);
+    }
+    let op = w[1];
+    if !ipc::admis(cap, tag, i, n, op, block::wire::lba(&w), false) {
+        return Err(REVOKED);
+    }
+    if op == 3 && !lire(adresse, &mut page) {
+        return Err(BAD_ADDRESS);
+    }
+    let autorise = || ipc::admis(cap, tag, i, n, op, block::wire::lba(&w), true);
+    let resultat = block::commande_groupee(pid.number, key, &w, &mut page, autorise);
+    ipc::termine(cap, tag, op, resultat.is_ok());
+    resultat?;
+    if op == 2
+        && !with(|s| {
+            heap::with_pages(|m| {
+                Ok(s.processes
+                    .get(pid)
+                    .space
+                    .as_ref()
+                    .unwrap()
+                    .copy_to_user(m, adresse, &page))
+            })
+            .unwrap()
+        })
+    {
+        return Err(BAD_ADDRESS);
+    }
+    Ok(0)
+}
