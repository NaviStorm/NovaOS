+impl IpcDevice<'_> {
+    pub(crate) fn groupe<T>(&self, action: impl FnOnce() -> T) -> T {
+        self.groupe.set(true);
+        let r = action();
+        self.groupe.set(false);
+        let mut pending = self.attente.borrow_mut();
+        pending.1.iter_mut().for_each(|p| p.fill(0));
+        pending.0.clear();
+        pending.1.clear();
+        r
+    }
+    fn lot(&self, b: &[u64], write: u8, addr: u64) -> Result<()> {
+        if b.is_empty() || b.len() > 128 {
+            return Err(Error::Invalid("taille du lot"));
+        }
+        let mut lbas = [0; 128];
+        for (l, &b) in lbas.iter_mut().zip(b) {
+            *l = self.geometry.sectors(b, 1)?.0;
+        }
+        self.exchange(|s| {
+            s.lot(
+                match write {
+                    0 => 2,
+                    1 => 3,
+                    _ => 6,
+                },
+                crate::runtime::config(10),
+                &lbas[..b.len()],
+                addr,
+            )
+        })
+    }
+}
