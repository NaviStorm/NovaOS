+// Vérification brève au moment où la chaîne devient visible dans la virtqueue.
+pub(in crate::sched::process) fn admis(
+    cap: u64,
+    tag: u64,
+    index: u64,
+    n: u64,
+    op: u8,
+    lba: u64,
+    soumission: bool,
+) -> bool {
+    with(|s| {
+        let pid = s.thread(s.current).owner.unwrap();
+        let Ok(node) = s.ipc.lookup(pid, cap, SEND | RECEIVE) else {
+            return false;
+        };
+        let Some(lane) = s.ipc.ends.get_mut(node.endpoint.slot()).bulk.as_mut() else {
+            return false;
+        };
+        if lane.parties[0] != pid.number || lane.handles[0] != cap {
+            return false;
+        }
+        let Some(r) = lane.reservation.as_mut() else {
+            return false;
+        };
+        let correspond = if index < n && index < 128 {
+            let debut = index as usize * 8;
+            let liste = s.ipc.pages_bulk.get(lane.slot);
+            lba == u64::from_le_bytes(liste[debut..debut + 8].try_into().unwrap())
+        } else {
+            op == 4 && lba == 0
+        };
+        let ok = correspond
+            && !r.en_vol
+            && !r.retrait
+            && !r.doute
+            && !r.flush
+            && r.effectues as u64 == index
+            && r.tag == tag
+            && r.n as u64 == n
+            && match op {
+                2 => r.lire && index < n && r.index as u64 == index,
+                3 => !r.lire && index < n && r.index as u64 == index + 1,
+                4 => r.exige_flush && !r.lire && index == n && r.index == r.n,
+                _ => false,
+            };
+        if ok && soumission {
+            r.en_vol = true;
+        }
+        ok
+    })
+}
+
+pub(in crate::sched::process) fn termine(cap: u64, tag: u64, op: u8, success: bool) {
+    with(|s| {
+        let pid = s.thread(s.current).owner.unwrap();
+        let Ok(node) = s.ipc.lookup(pid, cap, SEND | RECEIVE) else {
+            return;
+        };
+        let Some(lane) = s.ipc.ends.get_mut(node.endpoint.slot()).bulk.as_mut() else {
+            return;
+        };
+        let Some(r) = lane.reservation.as_mut() else {
+            return;
+        };
+        if lane.parties[0] != pid.number || lane.handles[0] != cap || r.tag != tag || !r.en_vol {
+            return;
+        }
+        r.en_vol = false;
+        if success {
+            if op == 4 {
+                r.flush = true;
+            } else {
+                r.effectues += 1;
+            }
+        } else {
+            r.doute = true;
+        }
+    })
+}
