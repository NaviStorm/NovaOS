+impl Domain {
+    // Le retrait ferme immédiatement l'admission. L'appelant réessaie après WOULD_BLOCK.
+    // REFUSED interdit de déclarer la révocation terminée en cas de DMA incertain.
+    pub(super) fn retrait_lot(&mut self, n: Node, descendance: bool) -> Res<()> {
+        let Some(lane) = self.ends.get(n.endpoint.slot()).bulk else {
+            return Ok(());
+        };
+        let touche = if descendance {
+            let descendants = self.descendants(n);
+            lane.nodes
+                .iter()
+                .any(|id| *id != n.id && descendants.has(id.slot()))
+        } else {
+            lane.nodes.contains(&n.id)
+        };
+        if !touche {
+            return Ok(());
