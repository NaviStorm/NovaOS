+// Le pilote copie une seule page à la fois. Aucun pointeur physique ni mapping
+// du moteur ne lui est remis. Chaque transfert résout à nouveau les deux capacités.
+#[derive(Clone, Copy)]
+struct Reservation {
+    moteur: Pid,
+    tag: u64,
+    lire: bool,
+    base: u64,
+    n: usize,
+    index: usize,
+    effectues: usize,
+    en_vol: bool,
+    retrait: bool,
+    doute: bool,
+    flush: bool,
+    exige_flush: bool,
+}
+pub(in crate::sched::process) fn lot(op: u64, cap: u64, desc: u64, size: u64) -> Res<u64> {
+    let attendu = if op == 0x1002e { 40 } else { 32 };
+    if size != attendu || desc % 8 != 0 {
+        return Err(BAD_ARGUMENT);
+    }
+    with(|s| {
+        let pid = s.thread(s.current).owner.unwrap();
+        let n = s.ipc.lookup(pid, cap, SEND | RECEIVE)?;
+        let pair = s
+            .ipc
+            .ends
+            .get_mut(n.endpoint.slot())
+            .bulk
+            .as_mut()
+            .ok_or(DENIED)?;
+        // Seule la paire privée du profil CLI possède SEND et RECEIVE aux deux extrémités.
+        let side = pair
+            .parties
+            .iter()
+            .position(|&p| p == pid.number)
+            .ok_or(DENIED)?;
+        if pair.handles[side] != cap || pair.len != 0 {
+            return Err(DENIED);
+        }
+        let espace = s.processes.get(pid).space.as_ref().ok_or(REVOKED)?;
+        let mut buf = [0u8; 40];
+        if !heap::with_pages(|m| Ok(espace.copy_from_user(m, desc, &mut buf[..attendu as usize])))
+            .unwrap()
+        {
+            return Err(BAD_ADDRESS);
+        }
+        let mot = |i: usize| u64::from_le_bytes(buf[i * 8..i * 8 + 8].try_into().unwrap());
+        let (tag, addr, taille, direction) = (mot(0), mot(1), mot(2), mot(3));
+        if tag == 0 || direction > 2 || !(1..=128).contains(&taille) {
+            return Err(BAD_ARGUMENT);
+        }
+        let lire = direction == 0;
+        if op == 0x1002e {
+            if side != 1 || pair.reservation.is_some() || tag <= pair.dernier_lot {
+                return Err(DENIED);
+            }
+            if addr
+                .checked_add(taille * 4096)
+                .is_none_or(|v| v > (1 << 47))
+            {
+                return Err(BAD_ADDRESS);
+            }
+            // L'aire appartient au seul moteur. Une lecture du disque requiert RW.
+            let ok = heap::with_pages(|m| {
+                Ok((0..taille).all(|i| espace.writable(m, addr + 4096 * i, 4096)))
+            })
+            .unwrap();
+            if !ok {
+                return Err(BAD_ADDRESS);
+            }
+            let adresses = &mut s.ipc.pages_bulk.get_mut(pair.slot)[..8 * taille as usize];
+            if !heap::with_pages(|m| Ok(espace.copy_from_user(m, mot(4), adresses))).unwrap() {
+                adresses.fill(0);
+                return Err(BAD_ADDRESS);
+            }
+            pair.dernier_lot = tag;
+            pair.reservation = Some(Reservation {
+                moteur: pid,
+                tag,
+                lire,
+                base: addr,
+                n: taille as usize,
+                index: 0,
+                effectues: 0,
+                en_vol: false,
+                retrait: false,
+                doute: false,
+                flush: false,
+                exige_flush: direction == 2,
+            });
+            return Ok(0);
+        }
+        if side != 0 {
+            return Err(DENIED);
+        }
+        let r = pair.reservation.as_mut().ok_or(REVOKED)?;
+        if r.retrait || r.doute {
+            return Err(REVOKED);
+        }
+        if r.tag != tag
+            || r.n != taille as usize
+            || r.lire != lire
+            || r.exige_flush != (direction == 2)
+        {
+            return Err(REFUSED);
+        }
+        if op == 0x10032 {
+            if r.index != r.n || r.effectues != r.n || r.en_vol || r.flush != r.exige_flush {
+                return Err(REFUSED);
+            }
+            s.ipc.pages_bulk.get_mut(pair.slot)[..8 * r.n].fill(0);
+            pair.reservation = None;
+            return Ok(0);
+        }
+        if r.index >= r.n {
+            return Err(REFUSED);
+        }
+        if op == 0x10030 {
+            return Ok(r.index as u64);
+        }
+        if lire && r.effectues != r.index + 1 {
+            return Err(REFUSED);
+        }
+        let autre = s.processes.get(r.moteur).space.as_ref().ok_or(REVOKED)?;
+        let p = r.base + 4096 * r.index as u64;
+        let scratch = &mut [0u8; 4096];
+        let ok = heap::with_pages(|m| {
+            Ok(if lire {
+                espace.copy_from_user(m, addr, scratch) && autre.copy_to_user(m, p, scratch)
+            } else {
+                autre.copy_from_user(m, p, scratch) && espace.copy_to_user(m, addr, scratch)
+            })
+        })
+        .unwrap();
+        scratch.fill(0);
+        if !ok {
+            return Err(BAD_ADDRESS);
+        }
+        r.index += 1;
+
+        Ok(4096)
+    })
+}
