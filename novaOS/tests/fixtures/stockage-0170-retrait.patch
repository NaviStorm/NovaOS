+    fn voie_vivante(&self, voie: VoieLot) -> bool {
+        if !self.ends.has(voie.endpoint.slot()) { return false; }
+        let ep = self.ends.get(voie.endpoint.slot());
+        ep.id == voie.endpoint && ep.bulk.as_ref().is_some_and(|l| l.nodes[1] == voie.pair)
+    }
+
+    fn retirer_reservation(&mut self, voie: VoieLot, demandeur: Option<(Pid, Id)>) {
+        if !self.voie_vivante(voie) { return; }
+        let lane = self.ends.get_mut(voie.endpoint.slot()).bulk.as_mut().unwrap();
+        if demandeur.is_none() {
+            // Contrôle révoqué ou session en retrait : aucun futur tag possible.
+            lane.dernier_lot = u64::MAX;
+        }
+        let Some(r) = lane.reservation.as_mut() else { return };
+        if demandeur.is_some_and(|d| d != (r.moteur, r.demandeur)) { return; }
+        r.retrait = true;
+        if !r.en_vol && !r.doute {
+            self.pages_bulk.get_mut(lane.slot)[..8 * r.n].fill(0);
+            lane.reservation = None;
+        }
