+    pub(super) fn fermer_controle_lot(&mut self, titulaire: usize, cle: u64) {
+        if let Some(l) = self.locals.get(titulaire).lot
+            && (cle == l.envoi || cle == l.reponse)
+        {
+            self.retirer_reservation(l.donnees, None);
+        }
+    }
