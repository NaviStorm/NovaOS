+
+/// Arrêt logique avant drainage. Seul l'acquit du Bail physique autorise la
+/// restitution des deux voies encore vivantes, y compris en reprise de quarantaine.
+pub(crate) fn fermer_lots_session(epoque: u64, confirme: bool) {
+    with(|s| {
+        let ipc = &mut s.ipc;
+        let Some(session) = ipc.session_lots.filter(|v| v.epoque == epoque) else { return };
+        ipc.retirer_reservation(session.donnees, None);
+        if confirme {
+            for voie in [session.donnees, session.offsets] {
+                if ipc.voie_vivante(voie) {
+                    ipc.release_lane(voie.endpoint);
+                }
+            }
+            ipc.session_lots = None;
+            ipc.collect();
+        }
+    });
+}
