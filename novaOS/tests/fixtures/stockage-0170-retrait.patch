+    pub(super) fn lier_attentes_lot(
+        &mut self, pilote: Pid, lot: u64, moteur: Pid, envoi: u64, reponse: u64,
+    ) -> Res<()> {
+        let donnees = self.lookup(pilote, lot, MANAGE)?.endpoint;
+        let lane = self.ends.get(donnees.slot()).bulk.as_ref().ok_or(DENIED)?;
+        if lane.parties != [pilote.number, moteur.number] || lane.handles[0] != lot {
+            return Err(DENIED);
+        }
+        let tx = self.lookup(moteur, envoi, SEND)?.endpoint;
+        let rx = self.lookup(moteur, reponse, RECEIVE)?.endpoint;
+        if tx == rx || tx == donnees || rx == donnees {
+            return Err(DENIED);
+        }
+        let donnees = VoieLot { endpoint: donnees, pair: lane.nodes[1] };
+        self.locals.get_mut(moteur.slot).lot = Some(AttentesLot { envoi, reponse, donnees });
+        Ok(())
+    }
+
+    pub(super) fn lier_session_lots(&mut self, epoque: u64, moteur: Pid, table: u64) -> Res<()> {
+        let attentes = self.caps(moteur).and_then(|c| c.lot).ok_or(DENIED)?;
+        let offsets = self.lookup(moteur, table, MANAGE)?.endpoint;
+        if epoque == 0 || self.session_lots.is_some() || offsets == attentes.donnees.endpoint {
+            return Err(REFUSED);
+        }
+        let lane = self.ends.get(offsets.slot()).bulk.as_ref().ok_or(DENIED)?;
+        let offsets = VoieLot { endpoint: offsets, pair: lane.nodes[1] };
+        self.session_lots = Some(SessionLots { epoque, donnees: attentes.donnees, offsets });
+        Ok(())
+    }
