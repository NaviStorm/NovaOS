+    /// La garde IPC ordonne la dernière vérification avant kick et l'abandon.
+    /// Un seul échange à la fois par thread ; son PID, sa génération, son canal
+    /// et l'incarnation de la lane sont vérifiés avant de toucher la réservation.
+    pub(super) fn abandon_sur_attente(&mut self, pid: Pid, thread: Id, canal: u64) {
+        let Some(l) = self.caps(pid).and_then(|c| c.lot) else { return };
+        if canal == l.envoi || canal == l.reponse {
+            self.retirer_reservation(l.donnees, Some((pid, thread)));
+        }
+    }
