+    pub fn charge_labo(&mut self, texte: &str) -> Result<(), &'static str> {
+        self.change();
+        let debut = self.at;
+        // Le terminal insère par frappes. Regrouper les octets ASCII de la fixture
+        // en fragments compatibles avec le budget d'une opération de l'historique.
+        for fragment in texte.as_bytes().chunks(4096) {
+            let s = core::str::from_utf8(fragment).map_err(|_| "UTF-8 invalide")?;
+            self.replace(self.at..self.at, s, self.at + s.len())?;
+        }
+        self.at = debut;
+        self.finish();
+        Ok(())
+    }
