+// Banc uniquement. Intercaler le retrait après le kick OUT de la première page,
+// avant de consommer le descripteur used ou d'acquitter la demande au pilote.
+use core::sync::atomic::{AtomicU64, Ordering::SeqCst};
+static RETRAIT: AtomicU64 = AtomicU64::new(0);
+static KICK: AtomicU64 = AtomicU64::new(0);
+pub(crate) fn arme_retrait(cap: u64) -> Res<u64> {
+    with(|s| {
+        let pid = s.thread(s.current).owner.unwrap();
+        let node = s.ipc.lookup(pid, cap, SEND | RECEIVE)?;
+        let lane = s.ipc.ends.get(node.endpoint.slot()).bulk.ok_or(DENIED)?;
+        if lane.handles[1] != cap || lane.parties[1] != pid.number {
+            return Err(DENIED);
+        }
+        RETRAIT.store(node.endpoint.0, SeqCst);
+        Ok(0)
+    })
+}
+pub(crate) fn retrait_arme() -> bool {
+    RETRAIT.load(SeqCst) != 0
+}
+pub(crate) fn injecte_retrait() {
+    let ep = RETRAIT.load(SeqCst);
+    if ep == 0 || KICK.load(SeqCst) != 0 {
+        return;
+    }
+    with(|s| {
+        let lane = s.ipc.ends.get(Reference(ep).slot()).bulk.unwrap();
+        let Some(r) = lane.reservation else {
+            return;
+        };
+        if r.lire || !r.en_vol {
+            return;
+        }
+        let root = s.ipc.node(lane.nodes[0]).unwrap();
+        assert_eq!(s.ipc.retrait_lot(root, true), Err(WOULD_BLOCK));
+        KICK.store(crate::hardware::block::kicks(), SeqCst);
+    })
+}
+pub(crate) fn confirme_retrait(cap: u64) -> bool {
+    let kick = KICK.load(SeqCst);
+    if kick == 0 {
+        return false;
+    }
+    with(|s| {
+        let pid = s.thread(s.current).owner.unwrap();
+        let root = s.ipc.lookup(pid, cap, MANAGE).unwrap();
+        assert_eq!(root.endpoint.0, RETRAIT.load(SeqCst));
+        assert_eq!(s.ipc.retrait_lot(root, true), Ok(()));
+        assert_eq!(s.ipc.revoke(root), 1);
+        assert!(s.ipc.ends.get(root.endpoint.slot()).bulk.is_none());
+        assert_eq!(crate::hardware::block::kicks(), kick);
+        KICK.store(0, SeqCst);
+        RETRAIT.store(0, SeqCst);
+    });
+    crate::hal::log(format_args!("COUPURE groupe retrait"));
+    true
+}
