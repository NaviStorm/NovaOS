+// Sonde du banc uniquement : formatage sur la pile, un DEBUG_WRITE par jalon.
+pub use core::sync::atomic::{AtomicUsize, Ordering::Relaxed};
+pub static READS: AtomicUsize = AtomicUsize::new(0);
+pub static ENGINE: AtomicUsize = AtomicUsize::new(0);
+pub fn profile(label: &str, rpc: u64) {
+    use core::fmt::Write;
+    struct Message([u8;128],usize);
+    impl Write for Message {
+        fn write_str(&mut self, s:&str) -> core::fmt::Result {
+            let end=self.1+s.len();
+            self.0.get_mut(self.1..end).ok_or(core::fmt::Error)?.copy_from_slice(s.as_bytes());
+            self.1=end; Ok(())
+        }
+    }
+    let mut b=Message([0;128],0);
+    let mem=heap::CURRENT.load(Relaxed);
+    write!(b,"VI-PROF {} alloc={} tas={} pic={} rpc={} read={} moteur={}",label,
+        heap::ALLOCS.load(Relaxed),mem,heap::HIGH.swap(mem,Relaxed),rpc,
+        READS.load(Relaxed),ENGINE.load(Relaxed)).unwrap();
+    runtime::value(runtime::call(runtime::DEBUG_WRITE,b.0.as_ptr() as u64,b.1 as u64,0)).unwrap();
+}
