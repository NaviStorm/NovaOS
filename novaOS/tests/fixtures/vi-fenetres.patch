+// Banc privé : aucune requête supplémentaire dans les images distribuées.
+fn windows(c: &mut Client, f: u64, expected: &[u8]) -> rt::Result<()> {
+    let mut data = [0xa5; 177];
+    let at = expected.len()-88;
+    ensure(c.read_grouped(f, at as u64, &mut data)? == 88)?;
+    ensure(data[..88] == expected[at..] && data[88..] == [0xa5; 89])?;
+    let frame = |flag, session, handle, off, total, n| {
+        let mut q = w::frame(w::READ, session, handle);
+        q[2] = flag;
+        w::set(&mut q, 24, off);
+        w::set(&mut q, 32, total);
+        w::size(&mut q, n);
+        q
+    };
+    let start = frame(w::START, c.session, f, 0, 176, 88);
+    let next = frame(w::CONTINUE, c.session, f, 88, 176, 88);
+    ensure(c.request(next).err() == Some(rt::REVOKED))?;
+    for (off, total, count) in [(u64::MAX,176,88), (0,4097,88), (0,176,87)] {
+        ensure(c.request(frame(w::START,c.session,f,off,total,count)).err() == Some(rt::BAD_ARGUMENT))?;
+    }
+    for (off,total) in [(87,176),(89,176),(88,175)] {
+        c.request(start)?;
+        ensure(c.request(frame(w::CONTINUE,c.session,f,off,total,88)).err() == Some(rt::BAD_ARGUMENT))?;
+        ensure(c.request(next).err() == Some(rt::REVOKED))?;
+    }
+    let second = c.open(b"/sortie",w::READABLE)?;
+    c.request(start)?;
+    ensure(c.request(frame(w::CONTINUE,c.session,second,88,176,88)).err() == Some(rt::REVOKED))?;
+    c.request(start)?;
+    ensure(c.request(frame(w::CONTINUE,c.session^1,f,88,176,88)).err() == Some(rt::DENIED))?;
+    let a=c.request(next)?;
+    ensure(w::length(&a)==88 && a[w::PAYLOAD..]==expected[88..176])?;
+    ensure(c.request(next).err() == Some(rt::REVOKED))?;
+    c.request(start)?;
+    c.close(second)?;
+    ensure(c.request(next).err() == Some(rt::REVOKED))?;
     Ok(())
