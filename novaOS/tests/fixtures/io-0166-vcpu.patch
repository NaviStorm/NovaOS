+static FLUSH: [AtomicU64; 2] = [const { AtomicU64::new(0) }; 2];
+static ENTREE_IDLE: [AtomicU64; crate::smp::MAX_CPUS] = [const { AtomicU64::new(0) }; crate::smp::MAX_CPUS];
+static MASQUE_IDLE: AtomicU64 = AtomicU64::new(0);
+static IDLE: AtomicU64 = AtomicU64::new(0);
+
+pub fn passage_idle(ancien: bool, nouveau: bool) {
+    let cpu = crate::smp::index();
+    if nouveau { MASQUE_IDLE.fetch_or(1 << cpu, Relaxed); } else { MASQUE_IDLE.fetch_and(!(1 << cpu), Relaxed); }
+    if ancien == nouveau || !ACTIVE.load(Relaxed) {
+        return;
+    }
+    let maintenant = hal::timer::counter();
+    if nouveau {
+        ENTREE_IDLE[cpu].store(maintenant, Relaxed);
+    } else {
+        let debut = ENTREE_IDLE[cpu].swap(0, Relaxed);
+        if debut != 0 { IDLE.fetch_add(maintenant.wrapping_sub(debut), Relaxed); }
+    }
+}
+
 pub fn bloc(op: usize, d: u64) {
     if op < 3 && ACTIVE.load(Relaxed) {
-        HW[2 * op].fetch_add(1, Relaxed);
+        let numero = HW[2 * op].fetch_add(1, Relaxed);
+        if op == 2 && numero < 2 {
+            FLUSH[numero as usize].store(d, Relaxed);
+        }
         HW[2 * op + 1].fetch_add(d, Relaxed);
     }
 }
