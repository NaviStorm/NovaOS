+static FLUSH: [AtomicU64; 2] = [const { AtomicU64::new(0) }; 2];
+static ENTREE_IDLE: AtomicU64 = AtomicU64::new(0);
+static IDLE: AtomicU64 = AtomicU64::new(0);
+
+pub fn passage_idle(ancien: bool, nouveau: bool) {
+    if ancien == nouveau || !ACTIVE.load(Relaxed) {
+        return;
+    }
+    let maintenant = hal::timer::counter();
+    if nouveau {
+        ENTREE_IDLE.store(maintenant, Relaxed);
+    } else {
+        IDLE.fetch_add(maintenant - ENTREE_IDLE.load(Relaxed), Relaxed);
+    }
+}
+
 pub fn bloc(op: usize, d: u64) {
