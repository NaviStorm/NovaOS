-        HW[2 * op].fetch_add(1, Relaxed);
+        let numero = HW[2 * op].fetch_add(1, Relaxed);
+        if op == 2 && numero < 2 {
+            FLUSH[numero as usize].store(d, Relaxed);
+        }
         HW[2 * op + 1].fetch_add(d, Relaxed);
     }
 }
