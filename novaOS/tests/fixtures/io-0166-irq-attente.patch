+//! Attente du seul transport bloc, sur le BSP. Le propriétaire conserve le
+//! mutex de session et les pages DMA pendant tout changement de pile.
+use super::*;
+use crate::sched::Event;
+use core::sync::atomic::AtomicBool;
+
+static EVENEMENT: Event = Event::new();
+static ARME: AtomicBool = AtomicBool::new(false);
+static DEBUT: AtomicU64 = AtomicU64::new(0);
+static HZ: AtomicU64 = AtomicU64::new(0);
+
+// Le contrôle de l'IRQ locale précède toute calibration du TSC x86 via le PIT.
+pub(super) fn preparer() -> Result<()> {
+    if HZ.load(Ordering::Relaxed) != 0 {
+        return Ok(());
+    }
+    if !hal::interrupts::Guard::new().was_enabled() {
+        return Err(Error::State);
+    }
+    let hz = hal::timer::counter_hz();
+    if hz == 0 || hz > u64::MAX / 2 {
+        return Err(Error::State);
+    }
+    HZ.store(hz, Ordering::Relaxed);
+    Ok(())
+}
+
+// Remplacé uniquement dans l'archive instrumentée.
+#[inline(always)]
+pub(super) fn noter(_: usize) {}
+
+fn reveiller(compteur: usize) {
+    // Appelé sous masque depuis le gestionnaire du disque ou du timer.
+    if ARME.swap(false, Ordering::Relaxed) {
+        assert!(EVENEMENT.notify_one().is_some());
+        noter(compteur);
+    }
+}
+
+pub(super) fn reveil_irq() {
+    reveiller(2);
+}
+
+pub(crate) fn tick() {
+    if ARME.load(Ordering::Relaxed)
+        && hal::timer::counter().wrapping_sub(DEBUT.load(Ordering::Relaxed)) >= HZ.load(Ordering::Relaxed)
+    {
+        reveiller(3);
+    }
+}
+
+impl Transport {
+    fn irq_complete(&self, avant: u64) -> bool {
+        IRQS.load(Ordering::Acquire) == avant.wrapping_add(1)
+            && EXPECT.load(Ordering::Acquire) == 0
+            && self.q.pages[2].mem.r16(2) == self.q.index
+    }
+
+    pub(super) fn collecter_irq(&self, avant: u64) -> Result<u32> {
+        let debut = hal::timer::counter();
+        let hz = HZ.load(Ordering::Relaxed);
+        let garde = hal::interrupts::Guard::new();
+        if self.irq_complete(avant) {
+            noter(0);
+            return self.q.lire_utilise();
+        }
+        if !garde.was_enabled() || hz == 0 {
+            return Err(Error::State);
+        }
+        // Le gestionnaire IRQ ne peut pas passer entre la revérification et
+        // Block(Event) sur le BSP. Seule l'IRQ qui valide le ticket, ou le
+        // timer périodique après une seconde, rend le thread à la file prête.
+        DEBUT.store(debut, Ordering::Relaxed);
+        assert!(!ARME.swap(true, Ordering::Relaxed));
+        noter(1);
+        EVENEMENT.wait(&garde);
+        assert!(!ARME.load(Ordering::Relaxed));
+        drop(garde);
+        if hal::timer::counter().wrapping_sub(debut) >= 2 * hz {
+            noter(6);
+            return Err(Error::Timeout);
+        }
+        if self.irq_complete(avant) {
+            return self.q.lire_utilise();
+        }
+        // Repli unique et borné après réveil sans complétion. Aucune nouvelle
+        // soumission. Le budget total est de deux secondes d'horloge invitée.
+        noter(4);
+        for _ in 0..4_000_000 {
+            if hal::timer::counter().wrapping_sub(debut) >= 2 * hz {
+                break;
+            }
+            if self.irq_complete(avant) {
+                noter(5);
+                return self.q.lire_utilise();
+            }
+            core::hint::spin_loop();
+        }
+        noter(6);
+        Err(Error::Timeout)
+    }
+}
