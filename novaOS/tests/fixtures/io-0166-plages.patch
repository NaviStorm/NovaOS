+//! Intervalles du tampon qui proviennent encore de la source épinglée.
+//! Les octets des insertions restent seulement dans le gap buffer.
+use alloc::vec::Vec;
+
+#[derive(Clone, Copy)]
+struct Intervalle {
+    courant: usize,
+    source: usize,
+    len: usize,
+}
+#[derive(Default)]
+pub(crate) struct Plages {
+    gardes: Vec<Intervalle>,
+    pub(super) origine: usize,
+    actif: bool,
+    litteral: bool,
+}
+impl Plages {
+    pub fn origine(n: usize) -> Self {
+        Self {
+            origine: n,
+            ..Default::default()
+        }
+    }
+    fn reserver(&mut self, n: usize) -> bool {
+        // En cas de fragmentation extrême, transmettre le préfixe représenté
+        // littéralement. Aucun octet n'est perdu lors de l'éviction de l'index.
+        if self.litteral {
+            return false;
+        }
+        if self.gardes.len() + n > 2048 || self.gardes.try_reserve(n).is_err() {
+            self.gardes.clear();
+            self.litteral = true;
+            return false;
+        }
+        true
+    }
+    pub fn changer(&mut self, at: usize, retire: usize, ajoute: usize) {
+        if !self.reserver(2) {
+            return;
+        }
+        if !self.actif {
+            self.actif = true;
+            if self.origine != 0 {
+                self.gardes.push(Intervalle {
+                    courant: 0,
+                    source: 0,
+                    len: self.origine,
+                });
+            }
+        }
+        let fin = at + retire;
+        let mut droite = None;
+        for g in &mut self.gardes {
+            let bout = g.courant + g.len;
+            if bout <= at {
+                continue;
+            }
+            if g.courant >= fin {
+                g.courant = g.courant - retire + ajoute;
+                continue;
+            }
+            let avant = at.saturating_sub(g.courant);
+            let apres = bout.saturating_sub(fin);
+            if apres != 0 {
+                let d = Intervalle {
+                    courant: at + ajoute,
+                    source: g.source + (fin - g.courant),
+                    len: apres,
+                };
+                if avant == 0 {
+                    *g = d;
+                    continue;
+                }
+                droite = Some(d);
+            }
+            g.len = avant;
+        }
+        self.gardes.retain(|g| g.len != 0);
+        if let Some(d) = droite {
+            let i = self.gardes.partition_point(|g| g.courant < d.courant);
+            self.gardes.insert(i, d);
+        }
+    }
+    pub fn prolonger(&mut self, at: usize, n: usize) {
+        if self.actif && n != 0 && self.reserver(1) {
+            if let Some(g) = self.gardes.last_mut()
+                && g.source + g.len == self.origine
+                && g.courant + g.len == at
+            {
+                g.len += n;
+            } else {
+                self.gardes.push(Intervalle {
+                    courant: at,
+                    source: self.origine,
+                    len: n,
+                });
+            }
+        }
+        self.origine += n;
+    }
+    pub fn prepend(&mut self, n: usize) {
+        if self.actif && self.reserver(1) {
+            for g in &mut self.gardes {
+                g.source += n;
+                g.courant += n;
+            }
+            self.gardes.insert(
+                0,
+                Intervalle {
+                    source: 0,
+                    courant: 0,
+                    len: n,
+                },
+            );
+        }
+        self.origine += n;
+    }
+    pub(crate) fn visiter(
+        &self,
+        n: usize,
+        source: bool,
+        mut f: impl FnMut(usize, usize, core::ops::Range<usize>),
+    ) {
+        if !source {
+            if n != 0 {
+                f(0, 0, 0..n);
+            }
+            return;
+        }
+        if !self.actif && !self.litteral {
+            return;
+        }
+        let (mut at, mut pos) = (0, 0);
+        for g in &self.gardes {
+            if g.source != at || g.courant != pos {
+                f(at, g.source - at, pos..g.courant);
+            }
+            at = g.source + g.len;
+            pos = g.courant + g.len;
+        }
+        if at != self.origine || pos != n {
+            f(at, self.origine - at, pos..n);
+        }
+    }
+}
