+//! La sélection de nom et le prêt doivent appartenir à la même délégation.
+use super::*;
+
+pub(super) fn publier(
+    s: &mut Session,
+    c: &Client,
+    targets: &[selected::Target],
+    q: &Frame,
+    port: u64,
+) -> rt::Result<()> {
+    if rt::config(11) == 0 {
+        return Err(rt::DENIED);
+    }
+    if s.pending.is_some() || c.copy.is_some() || !s.writable {
+        return Err(w::BUSY);
+    }
+    shape(w::word(q, 16) == 1 && q[2] == 0 && q[4..8] == [0; 4])?;
+    let (dest, source) = match targets {
+        [d] if q[24..48] == [0; 24] => (d, None),
+        [d, src] if src.scope == w::SELECT_FILE && src.kind == Kind::File => {
+            let fs = s.fs.as_ref().ok_or(rt::CLOSED)?;
+            let st = fs.stat_id(src.id).map_err(error)?;
+            if (st.id, st.revision, st.size) != (w::word(q, 24), w::word(q, 32), w::word(q, 40)) {
+                return Err(rt::REVOKED);
+            }
+            (d, Some(st))
+        }
+        _ => return Err(rt::DENIED),
+    };
+    if dest.scope != w::SELECT_NEW || dest.name.is_empty() {
+        return Err(rt::DENIED);
+    }
+    let len = w::word(q, 48);
+    let tag = w::word(q, 56);
+    shape((8..=8 * 1024 * 1024).contains(&len))?;
+    let scelle = len > 64;
+    shape(if scelle {
+        tag != 0 && q[64..].iter().all(|&b| b == 0)
+    } else {
+        tag == 0 && q[64 + len as usize..].iter().all(|&b| b == 0)
+    })?;
+    let lire = |at: u64, buf: &mut [u8]| -> rt::Result<()> {
+        if at.checked_add(buf.len() as u64).is_none_or(|v| v > len) {
+            return Err(rt::BAD_ARGUMENT);
+        }
+        if scelle {
+            let n = rt::bulk::pret(
+                0x10036,
+                port,
+                tag,
+                buf.as_mut_ptr() as u64,
+                buf.len() as u64,
+                at,
+            )?;
+            shape(n == buf.len() as u64)
+        } else {
+            buf.copy_from_slice(&q[64 + at as usize..64 + at as usize + buf.len()]);
+            Ok(())
+        }
+    };
+    let resultat = (|| {
+        let mut n = [0u8; 8];
+        lire(0, &mut n)?;
+        let n = u64::from_le_bytes(n);
+        shape(n <= 2049 && 8 + n * 24 <= len)?;
+        let debut = 8 + n * 24;
+        let mut entetes = Vec::new();
+        entetes
+            .try_reserve_exact(n as usize * 24)
+            .map_err(|_| rt::NO_MEMORY)?;
+        entetes.resize(n as usize * 24, 0);
+        if n != 0 {
+            lire(8, &mut entetes)?;
+        }
+        let mut plages = Vec::new();
+        plages
+            .try_reserve_exact(n as usize)
+            .map_err(|_| rt::NO_MEMORY)?;
+        for e in entetes.chunks_exact(24) {
+            plages.push(core::array::from_fn(|i| {
+                u64::from_le_bytes(e[8 * i..8 * i + 8].try_into().unwrap())
+            }));
+        }
+        s.clock.sample()?;
+        let fs = s.fs.as_mut().ok_or(rt::CLOSED)?;
+        s.dev.start_probe();
+        let mut interruption = None;
+        let r = s.dev.groupe(|| {
+            fs.sauvegarde_plages(
+                source,
+                dest.id,
+                &dest.name,
+                &plages,
+                len - debut,
+                |pos, b| {
+                    let r = if b.is_empty() && scelle {
+                        rt::bulk::pret(0x10037, port, tag, 0, 0, 0).map(|_| ())
+                    } else if b.is_empty() {
+                        Ok(())
+                    } else {
+                        lire(debut + pos, b)
+                    };
+                    r.map_err(|e| {
+                        interruption = Some(e);
+                        novafs::Error::Invalid("prêt retiré")
+                    })
