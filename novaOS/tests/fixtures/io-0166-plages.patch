+    assert!(vi.memory(|s, m| !s.copy_to_user(m, base + 4095, &[1, 2])
+        && s.resize_heap(m, base + 8192, base).is_err()));
+    assert_eq!(
+        demande(tiers, 0x10035, autre, 1, dest, 8192, 0),
+        Err(DENIED)
+    );
+    assert_eq!(demande(nsh, 0x10035, root, 1, dest, 8192, 0), Ok(0));
+    assert_eq!(
+        demande(fs, 0x10036, lecteur, 2, base, 8192, 0),
+        Err(REVOKED)
+    );
+    fs.put(base + 4096, &[9]);
+    assert_eq!(
+        demande(fs, 0x10036, lecteur, 1, base + 4096, 8192, 0),
+        Err(BAD_ADDRESS)
+    );
+    assert_eq!(fs.bytes::<1>(base + 4096), [9]);
+    assert_eq!(
+        demande(fs, 0x10036, lecteur, 1, base, 8192, 1),
+        Err(BAD_ARGUMENT)
+    );
+    assert_eq!(demande(fs, 0x10036, lecteur, 1, base, 8192, 0), Ok(8192));
+    assert_eq!(fs.bytes::<2>(base + 4095), [0x62, 0xb5]);
+    assert_eq!(demande(vi, 0x10038, voie, 1, 0, 0, 0), Ok(0));
+    assert_eq!(demande(fs, 0x10037, lecteur, 1, 0, 0, 0), Err(REVOKED));
+    assert!(vi.memory(|s, m| s.copy_to_user(m, base, &[3])));
+    assert_eq!(demande(vi, 0x10034, voie, 2, base, 8192, 0), Ok(8192));
+    assert_eq!(demande(nsh, 0x10035, root, 2, dest, 8192, 0), Ok(0));
+    assert_eq!(demande(fs, 0x10037, lecteur, 2, 0, 0, 0), Ok(0));
+    assert_eq!(nsh.call(IPC_REVOKE, dest, 0, 0), Err(WOULD_BLOCK));
+    assert_eq!(demande(vi, 0x10038, voie, 2, 0, 0, 0), Err(WOULD_BLOCK));
+    assert_eq!(demande(fs, 0x10039, lecteur, 2, 0, 0, 0), Ok(0));
+    assert_eq!(nsh.call(IPC_REVOKE, dest, 0, 0), Ok(1));
+    assert!(vi.memory(|s, m| s.copy_to_user(m, base + 4096, &[4])));
+    assert_eq!(demande(vi, 0x10034, voie, 3, base, 8192, 0), Ok(8192));
+    let lecteur = with(|s| s.ipc.derive(nsh.0, dest, fs.0, RECEIVE.into()).unwrap());
+    assert_eq!(demande(nsh, 0x10035, root, 3, dest, 8192, 0), Ok(0));
+    // Lancer les deux acteurs avant d'attendre leurs réponses. La lecture est
+    // soit complète, soit refusée sans modification de la destination.
+    fs.put(base, &[0x88; 4096]);
+    fs.put(base + 4096, &[0x88; 4096]);
+    let mut d = [0u8; 32];
+    d[..8].copy_from_slice(&3u64.to_le_bytes());
+    vi.put(DESC, &d);
+    d[8..16].copy_from_slice(&base.to_le_bytes());
+    d[16..24].copy_from_slice(&8192u64.to_le_bytes());
+    fs.put(DESC, &d);
+    fs.start(0x10036, lecteur, DESC, 32);
+    vi.start(0x10038, voie, DESC, 32);
+    match fs.result() {
+        Ok(8192) => assert_eq!(fs.bytes::<2>(base + 4095), [0x62, 4]),
+        Err(REVOKED) => assert_eq!(fs.bytes::<2>(base + 4095), [0x88; 2]),
+        autre => panic!("lecture en concurrence {autre:?}"),
+    }
+    assert_eq!(vi.result(), Ok(0));
+    assert_eq!(demande(fs, 0x10037, lecteur, 3, 0, 0, 0), Err(REVOKED));
+    assert_eq!(demande(vi, 0x10034, voie, 4, base, 8192, 0), Ok(8192));
+    assert_eq!(demande(nsh, 0x10035, root, 4, dest, 8192, 0), Ok(0));
+    assert!(nsh.call(IPC_REVOKE, dest, 0, 0).is_ok());
+    assert!(vi.memory(|s, m| s.copy_to_user(m, base + 32, &[5])));
+    let lecteur = with(|s| s.ipc.derive(nsh.0, dest, fs.0, RECEIVE.into()).unwrap());
+    assert_eq!(demande(vi, 0x10034, voie, 5, base, 8192, 0), Ok(8192));
+    assert_eq!(demande(nsh, 0x10035, root, 5, dest, 8192, 0), Ok(0));
+    assert_eq!(demande(fs, 0x10037, lecteur, 5, 0, 0, 0), Ok(0));
+    let [shell, editeur, moteur, tiers_enfant] = enfants;
+    vi.start(u64::MAX - 3, 0, 0, 0);
+    assert!(matches!(editeur.join(), Outcome::Fault(f) if f.address == base + 4096));
+    assert_eq!(nsh.call(IPC_REVOKE, dest, 0, 0), Err(WOULD_BLOCK));
+    assert_eq!(demande(fs, 0x10039, lecteur, 5, 0, 0, 0), Ok(0));
+    assert_eq!(nsh.call(IPC_REVOKE, dest, 0, 0), Ok(1));
+    with(|s| s.ipc.moteur_pret = None);
+    stop([shell, moteur, tiers_enfant], [nsh, fs, tiers]);
+}
