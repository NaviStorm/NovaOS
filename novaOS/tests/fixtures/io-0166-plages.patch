+//! Un prêt synchrone conserve ses pages dans le tas de l'éditeur. Le courtier
+//! délègue une lecture bornée au seul moteur de la session de qualification.
+use super::*;
+
+#[derive(Clone, Copy)]
+pub(super) struct Pret {
+    source: Pid,
+    voie: Reference,
+    courtier: Reference,
+    lecteur: Option<Reference>,
+    tag: u64,
+    base: u64,
+    len: u64,
+    publication: bool,
+}
+
+impl Pret {
+    pub(super) fn concerne(self, id: Reference) -> bool {
+        self.voie == id || self.courtier == id || self.lecteur == Some(id)
+    }
+}
+
+impl Domain {
+    fn vivant(&self, id: Reference) -> bool {
+        self.node(id)
+            .is_some_and(|n| n.holder != ABSENT && n.key != 0)
+    }
+    pub(super) fn garde_pret(&self, n: Node, descendants: bool) -> Res<()> {
+        if let Some(p) = self.pret
+            && p.publication
+        {
+            let atteint = |id: Reference| {
+                if descendants {
+                    id != n.id && self.descendants(n).has(id.slot())
+                } else {
+                    id == n.id
+                        || self.node(id).is_some_and(|v| {
+                            v.endpoint == n.endpoint
+                                && n.id == self.ends.get(n.endpoint.slot()).root
+                        })
+                }
+            };
+            if atteint(p.voie) || atteint(p.courtier) || p.lecteur.is_some_and(atteint) {
+                return Err(WOULD_BLOCK);
+            }
+        }
+        Ok(())
+    }
+}
+
+fn terminer(s: &mut Core) {
+    if let Some(p) = s.ipc.pret.take()
+        && let Some(proc) = &mut s.processes.slots[p.source.slot]
+        && proc.pid == p.source
+        && let Some(space) = &mut proc.space
+    {
+        heap::with_pages(|m| {
+            space.rendre_pret(m);
+            Ok(())
+        })
+        .unwrap();
+    }
+}
+
+pub(in crate::sched) fn collecter(s: &mut Core) {
+    if s.ipc.pret.is_some_and(|p| {
+        // Après admission, le moteur a fini de lire les pages. Une disparition
+        // de l'éditeur ne peut plus annuler une décision en cours de publication.
+        p.lecteur.is_some_and(|id| !s.ipc.vivant(id))
+            || !p.publication && (!s.ipc.vivant(p.voie) || !s.ipc.vivant(p.courtier))
+    }) {
+        terminer(s);
+    }
+}
+
+pub(in crate::sched::process) fn appel(op: u64, cap: u64, desc: u64, size: u64) -> Res<u64> {
+    if size != 32 || desc % 8 != 0 {
+        return Err(BAD_ARGUMENT);
+    }
+    with(|s| {
+        collecter(s);
+        let pid = s.thread(s.current()).owner.unwrap();
+        let droits = match op {
+            0x10035 => MANAGE,
+            0x10036 | 0x10037 | 0x10039 => RECEIVE,
+            _ => SEND,
+        };
+        let node = s.ipc.lookup(pid, cap, droits)?;
+        let espace = s.processes.get(pid).space.as_ref().ok_or(REVOKED)?;
+        let mut buf = [0u8; 32];
+        if !heap::with_pages(|m| Ok(espace.copy_from_user(m, desc, &mut buf))).unwrap() {
+            return Err(BAD_ADDRESS);
+        }
+        let word = |i: usize| u64::from_le_bytes(buf[i * 8..i * 8 + 8].try_into().unwrap());
+        let (tag, addr, len, off) = (word(0), word(1), word(2), word(3));
+        if tag == 0 {
+            return Err(BAD_ARGUMENT);
+        }
+        if op == 0x10034 {
+            if s.ipc.pret.is_some() {
+                return Err(WOULD_BLOCK);
+            }
+            let lane = s.ipc.ends.get(node.endpoint.slot()).bulk.ok_or(DENIED)?;
+            if !lane.editeur
+                || lane.nodes[1] != node.id
+                || lane.handles[1] != cap
+                || lane.parties[1] != pid.number
+            {
+                return Err(DENIED);
+            }
+            if tag <= lane.dernier_pret
+                || off != 0
+                || len == 0
+                || len > 8 * 1024 * 1024
+                || addr % 4096 != 0
+            {
+                return Err(BAD_ARGUMENT);
+            }
+            let espace = s.processes.get_mut(pid).space.as_mut().unwrap();
+            if !heap::with_pages(|m| Ok(espace.sceller_pret(m, addr, len))).unwrap() {
+                return Err(BAD_ADDRESS);
+            }
+            s.ipc
+                .ends
+                .get_mut(node.endpoint.slot())
+                .bulk
+                .as_mut()
+                .unwrap()
+                .dernier_pret = tag;
+            s.ipc.pret = Some(Pret {
+                source: pid,
+                voie: node.id,
+                courtier: lane.nodes[0],
+                lecteur: None,
+                tag,
+                base: addr,
+                len,
+                publication: false,
+            });
+            return Ok(len);
+        }
+        let p = s.ipc.pret.ok_or(REVOKED)?;
+        if p.tag != tag {
+            return Err(REVOKED);
+        }
+        match op {
+            0x10035 => {
+                if node.id != p.courtier || p.lecteur.is_some() || len != p.len || off != 0 {
+                    return Err(DENIED);
+                }
+                let root = s.ipc.lookup(pid, addr, MANAGE | SEND)?;
+                if root.id != s.ipc.ends.get(root.endpoint.slot()).root {
+                    return Err(DENIED);
+                }
+                let service = s.ipc.moteur_pret.ok_or(DENIED)?;
+                let mut candidats = s.ipc.nodes.ids().map(|i| *s.ipc.nodes.get(i)).filter(|v| {
+                    v.parent == root.id
+                        && v.rights == RECEIVE
+                        && v.holder as usize == service.slot
+                        && v.key != 0
+                });
+                let v = candidats.next().ok_or(DENIED)?;
+                if candidats.next().is_some()
+                    || s.processes.slots[service.slot]
+                        .as_ref()
+                        .is_none_or(|proc| proc.pid != service)
+                {
+                    return Err(DENIED);
+                }
+                s.ipc.pret.as_mut().unwrap().lecteur = Some(v.id);
+                Ok(0)
+            }
+            0x10036 => {
+                if p.lecteur != Some(node.id) || p.publication {
+                    return Err(DENIED);
+                }
+                if len == 0
+                    || len > 1024 * 1024
+                    || off.checked_add(len).is_none_or(|x| x > p.len)
+                    || addr.checked_add(len).is_none_or(|x| x > 1 << 47)
+                {
+                    return Err(BAD_ARGUMENT);
+                }
+                let source = s.processes.get(p.source).space.as_ref().ok_or(REVOKED)?;
+                let ok = heap::with_pages(|m| {
+                    Ok(source.copier_vers(espace, m, p.base + off, addr, len as usize))
+                })
+                .unwrap();
+                if ok { Ok(len) } else { Err(BAD_ADDRESS) }
+            }
+            0x10037 => {
+                if p.lecteur != Some(node.id) || [addr, len, off] != [0; 3] || p.publication {
+                    return Err(DENIED);
+                }
+                s.ipc.pret.as_mut().unwrap().publication = true;
+                Ok(0)
+            }
+            0x10038 => {
+                if node.id != p.voie || [addr, len, off] != [0; 3] {
+                    return Err(DENIED);
+                }
+                if p.publication {
+                    return Err(WOULD_BLOCK);
+                }
+                terminer(s);
+                Ok(0)
+            }
+            0x10039 => {
+                if p.lecteur != Some(node.id) || [addr, len, off] != [0; 3] {
+                    return Err(DENIED);
+                }
+                terminer(s);
+                Ok(0)
+            }
+            _ => Err(BAD_ARGUMENT),
+        }
+    })
+}
