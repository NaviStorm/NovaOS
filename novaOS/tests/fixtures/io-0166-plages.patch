+//! Paquet compact. La grande forme possède ses pages entières jusqu'au retour du prêt.
+use super::buffer::Buffer;
+use alloc::alloc::{Layout, alloc_zeroed, dealloc};
+use core::ptr::NonNull;
+use nova_cli::{runtime as rt, vi_wire as wire};
+
+struct Lot {
+    ptr: NonNull<u8>,
+    layout: Layout,
+}
+impl Lot {
+    fn new(n: usize) -> rt::Result<Self> {
+        let layout =
+            Layout::from_size_align(n.next_multiple_of(4096), 4096).map_err(|_| rt::LIMIT)?;
+        // Sûreté : ce Layout non vide réserve des pages entières exclusives au paquet.
+        let ptr = NonNull::new(unsafe { alloc_zeroed(layout) }).ok_or(rt::NO_MEMORY)?;
+        Ok(Self { ptr, layout })
+    }
+}
+impl Drop for Lot {
+    fn drop(&mut self) {
+        // Sûreté : aucune référence au contenu ne survit à ce propriétaire.
+        unsafe { dealloc(self.ptr.as_ptr(), self.layout) }
+    }
+}
+
+pub fn publier(
+    link: &mut wire::Link,
+    nom: &str,
+    b: &Buffer,
+    fin: Option<(usize, &Buffer)>,
+) -> rt::Result<()> {
+    let source = link.mode_plan == 1;
+    let mut count = 0usize;
+    let mut bytes = 0usize;
+    let fenetres = [Some((0, b)), fin];
+    for (_, b) in fenetres.into_iter().flatten() {
+        b.visiter(source, |_, _, r| {
+            count += 1;
+            bytes += r.len();
+        });
+    }
+    let en_tete = 8 + count * 24;
+    let taille = en_tete
+        .checked_add(bytes)
+        .filter(|&n| n <= wire::MAX_PLAN)
+        .ok_or(rt::LIMIT)?;
+    let mut court = [0u8; wire::PLAN_INLINE];
+    let lot;
+    let paquet = if taille <= court.len() {
+        &mut court[..taille]
+    } else {
+        lot = Lot::new(taille)?;
+        // Sûreté : allocation alignée et initialisée, emprunt unique pendant l'encodage.
+        unsafe { core::slice::from_raw_parts_mut(lot.ptr.as_ptr(), taille) }
+    };
+    paquet[..8].copy_from_slice(&(count as u64).to_le_bytes());
+    let (mut i, mut j) = (8, en_tete);
+    for (base, b) in fenetres.into_iter().flatten() {
+        b.visiter(source, |at, retire, r| {
+            for v in [base + at, retire, r.len()] {
+                paquet[i..i + 8].copy_from_slice(&(v as u64).to_le_bytes());
+                i += 8;
+            }
+            for s in b.parts(r) {
+                paquet[j..j + s.len()].copy_from_slice(s.as_bytes());
+                j += s.len();
+            }
+        });
+    }
+    link.publier_plan(nom, paquet)
+}
