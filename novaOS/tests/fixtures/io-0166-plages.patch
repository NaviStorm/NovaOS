+#[test]
+fn plages_sur_editions_et_annulations() {
+    let original = "a".repeat(257);
+    let mut b = Buffer::new(original.clone()).unwrap();
+    let mut reference = original.clone();
+    let mut seed = 17usize;
+    let verifier = |b: &Buffer, attendu: &str| {
+        let mut au = 0;
+        let mut reconstitue = String::new();
+        b.visiter(true, |at, del, r| {
+            assert!(au <= at && at + del <= original.len());
+            reconstitue.push_str(&original[au..at]);
+            for p in b.parts(r) {
+                reconstitue.push_str(p);
+            }
+            au = at + del;
+        });
+        reconstitue.push_str(&original[au..]);
+        assert_eq!(reconstitue, attendu);
+    };
+    for i in 0..700 {
+        seed = seed.wrapping_mul(1664525).wrapping_add(1013904223);
+        let j = seed % reference.chars().count();
+        let at = reference.char_indices().nth(j).unwrap().0;
+        let avant = reference.clone();
+        b.at = at;
+        b.change();
+        if i % 3 == 0 && reference.len() > 1 {
+            let end = at + reference[at..].chars().next().unwrap().len_utf8();
+            b.delete().unwrap();
+            reference.replace_range(at..end, "");
+        } else {
+            b.insert('Ω').unwrap();
+            reference.insert(at, 'Ω');
+        }
+        verifier(&b, &reference);
+        if i % 9 == 0 {
+            b.undo_redo(false).unwrap();
+            verifier(&b, &avant);
+            b.undo_redo(true).unwrap();
+            verifier(&b, &reference);
+        }
+    }
+}
