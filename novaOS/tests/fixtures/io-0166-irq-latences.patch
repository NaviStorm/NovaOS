+// Une seule sauvegarde sélectionnée. La sérialisation de la trace intervient
+// au bilan de session, après le message de succès et hors du chronométrage.
+static NB_LATENCES: AtomicU64 = AtomicU64::new(0);
+static LATENCES: [AtomicU64; 256] = [const { AtomicU64::new(0) }; 256];
+
+pub fn publier_latences_bloc() {
+    let n = NB_LATENCES.load(Relaxed);
+    hal::log(format_args!("SAVE latences_bloc n={n}"));
+    for (groupe, ligne) in LATENCES[..(n as usize).min(LATENCES.len())].chunks(8).enumerate() {
+        let mut valeurs = [0u64; 8];
+        for (dst, src) in valeurs.iter_mut().zip(ligne) {
+            *dst = src.load(Relaxed);
+        }
+        hal::log(format_args!(
+            "SAVE latences_bloc debut={} valeurs={:?}", groupe * 8, &valeurs[..ligne.len()]
+        ));
+    }
+}
