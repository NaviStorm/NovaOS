+// NovaOS Live x86_64: the first EFI has verified the loaded GPT partition
+// on USB. Resolve its whole-media handle before issuing any Block I/O.
+
+
+static void resolve_boot_media(void) {
+    EFI_GUID image_guid = EFI_LOADED_IMAGE_PROTOCOL_GUID;
+    EFI_GUID block_guid = BLOCK_IO_PROTOCOL;
+    EFI_LOADED_IMAGE_PROTOCOL *image = NULL;
+    if (gBS->HandleProtocol(efi_image_handle, &image_guid, (void **)&image) ||
+        !image || !image->DeviceHandle)
+        goto fail;
+    usb_partition = image->DeviceHandle;
+    EFI_DEVICE_PATH_PROTOCOL *path = get_device_path(usb_partition);
+    uint8_t parent[4096];
+    size_t used = 0;
+    bool usb = false;
+    while (path && used + 4 <= sizeof(parent)) {
+        size_t n = DevicePathNodeLength(path);
+        if (n < 4 || n > sizeof(parent) - used || IsDevicePathEnd(path))
+            goto fail;
+        if (path->Type == MEDIA_DEVICE_PATH) {
+            if (path->SubType != MEDIA_HARDDRIVE_DP || n != 42 || !usb ||
+                ((uint8_t *)path)[40] != 2 || ((uint8_t *)path)[41] != 2)
+                goto fail;
+            EFI_DEVICE_PATH_PROTOCOL *tail = (void *)((uint8_t *)path + n);
+            if (tail->Type != END_DEVICE_PATH_TYPE || tail->SubType != END_ENTIRE_DEVICE_PATH_SUBTYPE ||
+                DevicePathNodeLength(tail) != 4)
+                goto fail;
+            memcpy(parent + used, tail, 4);
+            EFI_DEVICE_PATH_PROTOCOL *cursor = (void *)parent;
+            if (gBS->LocateDevicePath(&block_guid, &cursor, &usb_disk) ||
+                !usb_disk || usb_disk == usb_partition || (uint8_t *)cursor != parent + used)
+                goto fail;
+            EFI_DEVICE_PATH_PROTOCOL *actual = get_device_path(usb_disk);
+            size_t offset = 0;
+            while (actual && offset < used + 4) {
+                EFI_DEVICE_PATH_PROTOCOL *expected = (void *)(parent + offset);
+                size_t size = DevicePathNodeLength(expected);
+                if (DevicePathNodeLength(actual) != size || memcmp(actual, expected, size))
+                    goto fail;
+                offset += size;
+                actual = (void *)((uint8_t *)actual + size);
+            }
+            if (offset != used + 4)
+                goto fail;
+            return;
+        }
+        if (path->Type == MESSAGING_DEVICE_PATH && path->SubType == MSG_USB_DP && n == 6)
+            usb = true;
+        memcpy(parent + used, path, n);
+        used += n;
+        path = (void *)((uint8_t *)path + n);
+    }
+fail:
+    panic(false, "NovaOS: no exact USB boot disk");
+}
