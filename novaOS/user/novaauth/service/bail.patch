-            .map_err(|_| rt::DENIED)?;
+        let tick = now()?;
+        let result = self.sessions.inspect(id, self.route, Some(current), tick);
+        self.checked = Some((tick, result.is_ok()));
+        result.map_err(|_| rt::DENIED)?;
