+// Sonde de recette du bail. Aucun identifiant de session ou contenu IPC dans ce marqueur.
+struct Trace { bytes: [u8; 192], len: usize }
+impl core::fmt::Write for Trace {
+    fn write_str(&mut self, value: &str) -> core::fmt::Result {
+        let end = self.len + value.len();
+        self.bytes.get_mut(self.len..end).ok_or(core::fmt::Error)?.copy_from_slice(value.as_bytes());
+        self.len = end;
+        Ok(())
+    }
+}
