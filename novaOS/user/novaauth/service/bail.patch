+            || (result.is_err() && matches!(op, b"NSHEXBG1" | b"NSHLIVE1")) {
+            use core::fmt::Write;
+            let mut trace = Trace { bytes: [0; 192], len: 0 };
+            let code = result.err().unwrap_or(0);
+            let (tick, permitted) = login.checked.unwrap_or((0, false));
+            if write!(&mut trace, "NXBAIL op={} tag={} decision={} valide={} echeance={} retour={} fin={}",
+                core::str::from_utf8(op).unwrap_or("?"), m.tag, tick, permitted as u8,
+                login.relay_deadline, code, now().unwrap_or(0)).is_ok() {
+                marker(&trace.bytes[..trace.len]);
+            }
+        }
diff --git a/components/shell/session_auth_lab.rs b/components/shell/session_auth_lab.rs
index 2ab1901c763240e06c22cc1c9ff0eff5c82bcda3..058e2ddf81bb71ee8e13b201038e7ba0fc25cd57 100644
--- a/components/shell/session_auth_lab.rs
+++ b/components/shell/session_auth_lab.rs
@@ -26,0 +27,25 @@
+            ["attendre-bail", path] => {
+                let read = fs.open_at(0, path.as_bytes(), 0x80 | w::READABLE)?;
+                let mut one = [0];
+                let check = (|| {
+                    if fs.read(read, 0, &mut one)? != 1 { return Err(rt::REFUSED); }
+                    // Voie de réponse privée au repos. IPC attend en ticks (250 Hz).
+                    if rt::receive_for(rt::config(17), 15000).err() != Some(rt::TIMED_OUT) {
+                        return Err(rt::REFUSED);
+                    }
+                    let access = fs.read(read, 0, &mut one);
+                    super::console::write(super::tty::OUTPUT,
+                        &alloc::format!("NXBAIL ancien handle lecture={}\n", access.err().unwrap_or(0)))?;
+                    Ok(())
+                })();
+                let _ = fs.close(read);
+                check?;
+            }
+            ["reauthentifier"] => {
+                // Deux demandes explicites sur la même route du shell, après la tentative expirée.
+                let closed = self.close();
+                let opened = self.authenticate();
+                super::console::write(super::tty::OUTPUT, &alloc::format!(
+                    "NXBAIL reauth fermeture={} ouverture={}\n", closed.err().unwrap_or(0), opened.err().unwrap_or(0)))?;
+                opened?;
+            }
