+    pub(crate) fn authority_cell(&self, sector: &mut [u8], write: bool) -> crate::runtime::Result<()> {
+        if self.failed.get() || self.count != 514 || crate::runtime::config(13) != 0x4e4133 {
+            return Err(crate::runtime::REFUSED);
+        }
+        let size = self.geometry.sector_size() as usize;
