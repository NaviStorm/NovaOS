--- a/novaOS/user/storage/fileapi.rs
+++ b/novaOS/user/storage/fileapi.rs
@@ -70,0 +71,31 @@
+    /// Recette QEMU sur la route authentifiée du shell. Deux dépôts en vol
+    /// visent exactement le même nom avant la collecte du premier résultat.
+    pub fn probe_exclusive(&mut self,path:&[u8])->rt::Result<()> {
+        if self.disconnected || path.is_empty() || path.len()>w::FRAGMENT{return Err(rt::BAD_ARGUMENT);}
+        let mut q=w::frame(w::OPEN_AT,self.session,0);
+        q[2]=0x80|w::CREATE|w::WRITABLE;
+        w::size(&mut q,path.len()); q[w::PAYLOAD..w::PAYLOAD+path.len()].copy_from_slice(path);
+        let first=self.tag.checked_add(1).ok_or(rt::LIMIT)?;
+        self.tag=first.checked_add(1).ok_or(rt::LIMIT)?;
+        for seq in [first,self.tag] {
+            rt::send_frame(self.tx,seq,&q,0,false)?;
+        }
+        let mut winner=None;
+        let mut errors=0;
+        for seq in [first,self.tag] {
+            let m=rt::receive_for(self.rx,15000)?;
+            if m.kind!=1 || m.tag!=seq || m.len!=128 || m.payload[..2]!=q[..2] {return Err(rt::REFUSED);}
+            match u64::from(m.payload[3]) {
+                0 if winner.is_none()=>winner=Some(w::word(&m.payload,16)),
+                w::EXISTS=>errors+=1,
+                e=>return Err(if e==0 {rt::REFUSED} else {e}),
+            }
+        }
+        let key=winner.ok_or(rt::REFUSED)?;
+        self.write(key,0,b"unique")?;
+        self.sync(key)?;
+        self.close(key)?;
+        if errors!=1{return Err(rt::REFUSED);}
+        Ok(())
+    }
+
