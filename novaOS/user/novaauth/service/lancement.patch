index acf0456d80ab86fc75ca6778824f19ac7da3f49e..32d392ea06876736dca83b0874b37d83e7610e6c 100644
--- a/novaOS/kernel/src/sched/process/ipc/pipe.rs
+++ b/novaOS/kernel/src/sched/process/ipc/pipe.rs
@@ -94,0 +95,19 @@
+    #[cfg(feature="novaauth-sessions-lab")]
+    pub(super) fn relay_direction(&self, shell:Pid, root:Node, direction:u32)->Res<()> {
+        let owner=self.lookup(shell,root.key,MANAGE)?;
+        let end=self.ends.get(root.endpoint.slot());
+        let p=end.pipe.ok_or(DENIED)?;
+        if owner.id!=root.id || root.id!=end.root || end.owner!=shell.number {return Err(DENIED);}
+        if p.revoked {return Err(REVOKED);}
+        match direction {
+            SEND if p.writer.is_none() && !p.writer_closed && !p.reader_closed=>Ok(()),
+            RECEIVE if p.reader.is_none() && !p.reader_closed=>Ok(()),
+            _=>Err(REFUSED)
+        }
+    }
+    #[cfg(feature="novaauth-sessions-lab")]
+    pub(super) fn relay_attached(&mut self,root:Node,recipient:Pid,direction:u32) {
+        let p=self.ends.get_mut(root.endpoint.slot()).pipe.as_mut().unwrap();
+        if direction==SEND {p.writer=Some(recipient);} else {p.reader=Some(recipient);}
+    }
+
